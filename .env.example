# =============================================================
# WorkTogether - Environment Configuration
# =============================================================
# SAO CHÉP file này thành .env rồi điền giá trị thực
# KHÔNG BAO GIỜ commit file .env lên git
# =============================================================

# -------------------------------------------------------------
# PostgreSQL
# -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=postgres

# -------------------------------------------------------------
# Redis
# -------------------------------------------------------------
REDIS_PASSWORD=change_me_redis_password

# -------------------------------------------------------------
# MinIO (Object Storage)
# -------------------------------------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_password

# -------------------------------------------------------------
# JWT
# -------------------------------------------------------------
JWT_SECRET=change_me_jwt_secret_at_least_32_chars_long

# -------------------------------------------------------------
# Auth Service
# -------------------------------------------------------------
AUTH_PORT=8081
# Đặt thành "true" CHỈ trong môi trường dev (bỏ qua xác thực email)
AUTO_VERIFY_EMAIL=false
FRONTEND_URL=http://localhost:4200

# URL gốc của API server (dùng trong link email xác thực)
APP_BASE_URL=http://localhost:8080

# -------------------------------------------------------------
# SMTP Email (Gmail / SendGrid / ...)
# -------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx   # Gmail App Password (16 ký tự)
SMTP_FROM=your_email@gmail.com

# -------------------------------------------------------------
# Google OAuth 2.0
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Realtime translation and voice subtitles (Google Cloud service account)
# Host path used only with docker-compose.translation.yml; never commit this key file.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
TRANSLATION_MAX_CHARS_PER_MINUTE=30000

# -------------------------------------------------------------
# User Service
# -------------------------------------------------------------
USER_PORT=8082

# -------------------------------------------------------------
# Room Service
# -------------------------------------------------------------
ROOM_PORT=8083

# -------------------------------------------------------------
# Chat Service
# -------------------------------------------------------------
CHAT_PORT=8084

# -------------------------------------------------------------
# Music Service
# -------------------------------------------------------------
MUSIC_PORT=8085
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=music
MINIO_PUBLIC_URL=http://localhost:9000

# -------------------------------------------------------------
# Playlist Service
# -------------------------------------------------------------
PLAYLIST_PORT=8086

# -------------------------------------------------------------
# Playback Service
# -------------------------------------------------------------
PLAYBACK_PORT=8087

# -------------------------------------------------------------
# Voice Service (LiveKit)
# -------------------------------------------------------------
VOICE_PORT=8088
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev_livekit_secret_change_me_32_chars_minimum
# Production-only: use with docker compose -f docker-compose.yml -f docker-compose.prod.yml
LIVEKIT_DOMAIN=livekit.example.com
LIVEKIT_TURN_DOMAIN=turn.example.com
LIVEKIT_TURN_CERT_FILE=/etc/letsencrypt/live/turn.example.com/fullchain.pem
LIVEKIT_TURN_KEY_FILE=/etc/letsencrypt/live/turn.example.com/privkey.pem

# -------------------------------------------------------------
# Notification Service
# -------------------------------------------------------------
NOTIFICATION_PORT=8089

# -------------------------------------------------------------
# Nginx Gateway
# -------------------------------------------------------------
GATEWAY_PORT=8080
